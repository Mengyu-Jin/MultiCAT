# Copy this file to .env and fill in your own API keys.
# Do NOT commit the real .env file — it is already excluded via .gitignore.

# OpenRouter: unified routing to Gemini Flash / GPT-4.1-mini / Claude Sonnet
OPENROUTER_API_KEY=

# Elsevier full-text XML access
ELSEVIER_API_KEY=

# Scopus DOI search (used by config.yaml scopus queries)
SCOPUS_API_KEY=

# Model routing (defaults shown; override if you want different models)
OPENROUTER_SCREENING_MODEL=google/gemini-2.5-flash
OPENROUTER_EXTRACTION_MODEL=google/gemini-2.5-flash
OPENROUTER_REPAIR_MODEL=openai/gpt-4.1-mini
OPENROUTER_JUDGE_MODEL=anthropic/claude-sonnet-4.5

# Contact email sent to CrossRef, OpenAlex and NCBI (PMC) as their API etiquette requires
CONTACT_EMAIL=
